{
  "manifest_version": 3,
  "name": "DateHeure AutoFill",
  "version": "1.2.0",
  "description": "Insère la date et l'heure courante dans un champ texte (ex : samedi 25 avril à 21h18)",
  "permissions": ["contextMenus", "scripting", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
